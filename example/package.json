{
  "name": "list-scrubber-example",
  "version": "1.0.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "ios": "expo run:ios",
    "android": "expo run:android",
    "web": "expo start --web",
    "export:web": "expo export --platform web",
    "web:e2e": "expo export --platform web && playwright test",
    "typecheck": "tsc --noEmit -p tsconfig.typecheck.json",
    "e2e:start": "EXPO_PUBLIC_E2E=1 expo start --clear",
    "e2e:start:rtl": "EXPO_PUBLIC_E2E=1 EXPO_PUBLIC_E2E_RTL=1 expo start --clear",
    "e2e:build:ios": "sh scripts/e2e-build.sh ios",
    "e2e:build:android": "sh scripts/e2e-build.sh android",
    "e2e:ios": "sh scripts/e2e.sh ios",
    "e2e:android": "sh scripts/e2e.sh android"
  },
  "dependencies": {
    "@expo/metro-runtime": "~58.0.17",
    "@legendapp/list": "^3.6.0",
    "@shopify/flash-list": "2.3.2",
    "expo": "~58.0.26",
    "expo-haptics": "~58.0.8",
    "expo-status-bar": "~58.0.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-web": "^0.21.4",
    "react-native-worklets": "0.13.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/react": "~19.3.0",
    "typescript": "~6.0.3"
  }
}
