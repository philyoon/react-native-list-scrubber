{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true,
    // Like metro.config.js: the library source in ../src, and its peers from this app's node_modules (not the
    // repo root's, which can be on other versions), as an app installing the package would resolve them
    "paths": {
      "react-native-list-scrubber": ["../src/index.ts"],
      "react": ["./node_modules/@types/react"],
      "react/*": ["./node_modules/@types/react/*"],
      "react-native": ["./node_modules/react-native"],
      "react-native/*": ["./node_modules/react-native/*"],
      "react-native-reanimated": ["./node_modules/react-native-reanimated"],
      "react-native-worklets": ["./node_modules/react-native-worklets"],
      "react-native-gesture-handler": ["./node_modules/react-native-gesture-handler"],
      "react-native-gesture-handler/*": ["./node_modules/react-native-gesture-handler/*"]
    }
  },
  "include": ["src", "index.ts"]
}
