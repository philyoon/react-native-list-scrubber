{
  "name": "react-native-list-scrubber",
  "version": "0.1.1",
  "description": "Fast scrolling for long React Native lists: a draggable thumb with section labels (A–Z, dates…), on the UI thread with Reanimated 4 (New Architecture), and an adjustable screen-reader control.",
  "keywords": [
    "react-native",
    "flatlist",
    "flashlist",
    "sectionlist",
    "legend-list",
    "scrollbar",
    "fast-scroll",
    "scrubber",
    "section-index",
    "reanimated",
    "gesture-handler",
    "accessibility",
    "contacts"
  ],
  "license": "MIT",
  "author": "Phil Yoon",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/philyoon/react-native-list-scrubber.git"
  },
  "bugs": "https://github.com/philyoon/react-native-list-scrubber/issues",
  "homepage": "https://github.com/philyoon/react-native-list-scrubber#readme",
  "main": "./lib/module/index.js",
  "types": "./lib/typescript/src/index.d.ts",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./lib/typescript/src/index.d.ts",
      "default": "./lib/module/index.js"
    },
    "./jest": {
      "source": "./src/jest.tsx",
      "types": "./lib/typescript/src/jest.d.ts",
      "default": "./lib/module/jest.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "lib",
    "CHANGELOG.md",
    "!**/__tests__",
    "!**/__fixtures__",
    "!**/__mocks__"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "bob build",
    "smoke:package": "node scripts/smoke-test-package.mjs",
    "prepare": "bob build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format:check": "prettier --check src scripts eslint.config.mjs example/src example/e2e example/web-e2e example/playwright.config.ts example/scripts README.md CHANGELOG.md CONTRIBUTING.md",
    "test": "jest",
    "example": "npm --prefix example run",
    "e2e:start": "npm --prefix example run e2e:start",
    "e2e:start:rtl": "npm --prefix example run e2e:start:rtl",
    "e2e:ios": "npm --prefix example run e2e:ios --",
    "e2e:android": "npm --prefix example run e2e:android --"
  },
  "peerDependencies": {
    "react": ">=19.0.0",
    "react-native": ">=0.78.0",
    "react-native-gesture-handler": ">=2.20.0",
    "react-native-reanimated": ">=4.1.0",
    "react-native-worklets": ">=0.5.0"
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      [
        "module",
        {
          "esm": true
        }
      ],
      [
        "typescript",
        {
          "project": "tsconfig.build.json"
        }
      ]
    ]
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@react-native/babel-preset": "^0.87.1",
    "@react-native/jest-preset": "^0.87.1",
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.3.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jest": "~29.7.0",
    "prettier": "^3.9.9",
    "react": "19.3.0",
    "react-native": "^0.87.1",
    "react-native-builder-bob": "^0.43.1",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "^4.7.1",
    "react-native-worklets": "^0.13.0",
    "react-test-renderer": "^19.3.0",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.71.1"
  },
  "overrides": {
    "react": "$react"
  }
}
