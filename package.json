{
  "name": "react-native-list-scrubber",
  "version": "0.1.0",
  "description": "Drag-to-scrub handle for long React Native lists: runs on the UI thread, shows a label bubble (A–Z, dates…), and gives screen readers an adjustable control.",
  "keywords": [
    "react-native",
    "flatlist",
    "flashlist",
    "legend-list",
    "scrollbar",
    "fast-scroll",
    "scrubber",
    "section-index",
    "reanimated",
    "gesture-handler",
    "accessibility"
  ],
  "license": "MIT",
  "author": "Phil Yoon",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/philyoon/react-native-list-scrubber.git"
  },
  "bugs": "https://github.com/philyoon/react-native-list-scrubber/issues",
  "homepage": "https://github.com/philyoon/react-native-list-scrubber#readme",
  "main": "./lib/module/index.js",
  "types": "./lib/typescript/src/index.d.ts",
  "exports": {
    ".": {
      "source": "./src/index.tsx",
      "types": "./lib/typescript/src/index.d.ts",
      "default": "./lib/module/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "lib",
    "!**/__tests__",
    "!**/__fixtures__",
    "!**/__mocks__"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "bob build",
    "prepare": "bob build",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "example": "npm --prefix example run"
  },
  "peerDependencies": {
    "react": "*",
    "react-native": "*",
    "react-native-gesture-handler": ">=2.20.0",
    "react-native-reanimated": ">=4.0.0",
    "react-native-worklets": ">=0.5.0"
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      [
        "module",
        {
          "esm": true
        }
      ],
      [
        "typescript",
        {
          "project": "tsconfig.build.json"
        }
      ]
    ]
  },
  "devDependencies": {
    "@react-native/babel-preset": "^0.86.3",
    "@react-native/jest-preset": "^0.86.3",
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.2.0",
    "jest": "~29.7.0",
    "prettier": "^3.9.9",
    "react": "^19.2.3",
    "react-native": "^0.86.3",
    "react-native-builder-bob": "^0.43.1",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "^4.5.1",
    "react-native-worklets": "^0.10.1",
    "react-test-renderer": "^19.2.3",
    "typescript": "~5.9.2"
  }
}
